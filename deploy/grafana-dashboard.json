        {
          "datasource": {
            "type": "influxdb",
            "uid": "garmin_influxdb"
          },
          "refId": "A",
          "query": "SELECT last(\"weight_kg\") FROM \"aeke_body\" WHERE $timeFilter GROUP BY time($__interval) fill(previous)",
          "rawQuery": true,
          "resultFormat": "time_series",
          "alias": "AEKE (scale)"
