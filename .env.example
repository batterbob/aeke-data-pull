# Copy to .env and fill in. .env is git-ignored — never commit real values.

# Required: your AEKE bearer token (the `authorization` header value from the app).
AEKE_TOKEN=

# Optional
AEKE_BASE=service-us.aeke.com   # use service-cn.aeke.com etc. for other regions
AEKE_UNITS=metric               # metric (kg) or imperial (lb)
AEKE_TZ=UTC                     # e.g. America/New_York

# Optional: InfluxDB target for `aeke_export.py influx`.
# Use EITHER the v1 block OR the v2 block (v1 wins if INFLUX_V1_URL is set).

# InfluxDB 1.x
INFLUX_V1_URL=          # e.g. http://garmin-influxdb:8086
INFLUX_V1_DB=           # e.g. GarminStats
INFLUX_V1_USER=
INFLUX_V1_PASSWORD=

# InfluxDB 2.x
INFLUX_URL=
INFLUX_TOKEN=
INFLUX_ORG=
INFLUX_BUCKET=

# Optional alerting via Telegram (deploy/run-poll.sh). If both are set, you get
# one message when a poll fails and one when the token is within ALERT_WARN_DAYS
# of expiry (deduped so it's a single nudge, not a daily nag).
ALERT_TELEGRAM_BOT_TOKEN=
ALERT_TELEGRAM_CHAT_ID=
ALERT_WARN_DAYS=5

# docker network the poller container joins to reach InfluxDB (deploy/run-poll.sh)
INFLUX_DOCKER_NETWORK=garmin-grafana_default

# On-demand token-refresh window (deploy/refresh_window.py). When the token is
# within REFRESH_TRIGGER_DAYS of expiry, the poller spins mitmproxy up, alerts
# you with steps, captures the new token, and tears the proxy back down. Needs
# the mitmproxy CA volume to persist so the phone's trusted cert keeps working.
MITM_WEB_PASSWORD=changeme
MITM_VOLUME=/path/to/mitmproxy-confdir   # persistent CA lives here
MITM_PROXY_PORT=8081
MITM_WEB_PORT=8082
MITM_CONTAINER=aeke-mitm-refresh
MITM_LAN_HOST=192.168.1.5                # address the phone points its proxy at
REFRESH_TRIGGER_DAYS=3
REFRESH_WINDOW_MINUTES=360
REFRESH_POLL_SECS=10
